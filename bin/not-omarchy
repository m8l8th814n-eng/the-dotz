#!/bin/bash
# Omarchy-style screensaver. Bind it however you like.

TXT="$HOME/.config/not-omarchy/screensaver.txt"

if [ ! -f "$TXT" ]; then
    echo "not-omarchy: missing $TXT" >&2
    exit 1
fi

if [ "$1" != "--inner" ]; then
    exec foot --app-id=not-omarchy --fullscreen -- "$0" --inner
fi

cleanup() {
    [ -n "$TTE_PID" ] && kill "$TTE_PID" 2>/dev/null
    printf '\033[?25h'
    exit 0
}
trap cleanup SIGINT SIGTERM SIGHUP SIGQUIT EXIT

printf '\033]11;rgb:00/00/00\007'
printf '\033[?25l'
clear

while true; do
    tte -i "$TXT" \
        --frame-rate 120 --canvas-width 0 --canvas-height 0 \
        --reuse-canvas --anchor-canvas c --anchor-text c \
        --random-effect --exclude-effects dev_worm \
        --no-eol --no-restore-cursor &
    TTE_PID=$!

    while kill -0 "$TTE_PID" 2>/dev/null; do
        if read -rsn1 -t 1; then
            cleanup
        fi
    done
done
